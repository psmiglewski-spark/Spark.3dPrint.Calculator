<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Spark._3dPrint.Calculator.ViewModels"
             xmlns:models="clr-namespace:Spark._3dPrint.Calculator.Models"
             x:Class="Spark._3dPrint.Calculator.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Ustawienia">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Frame BorderColor="#512BD4" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Parametry drukarki"
                           FontSize="18"
                           FontAttributes="Bold"/>

                    <Label Text="Koszt energii (zl/kWh):"/>
                    <Entry Keyboard="Numeric"
                           Text="{Binding ElectricityCost}"/>

                    <Label Text="Moc drukarki (W):"/>
                    <Entry Keyboard="Numeric"
                           Text="{Binding PrinterPower}"/>

                    <Button Text="Zapisz ustawienia"
                            Command="{Binding SavePrinterSettingsCommand}"
                            BackgroundColor="#512BD4"
                            TextColor="White"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="#512BD4" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Zarzadzanie filamentami"
                           FontSize="18"
                           FontAttributes="Bold"/>

                    <Button Text="Importuj liste filamentow (domyslna)"
                            Command="{Binding ImportFilamentsFromPackageCommand}"
                            BackgroundColor="#2E8B57"
                            TextColor="White"/>

                    <Button Text="Pobierz liste filamentow i srednie ceny z internetu"
                            Command="{Binding SyncFilamentsFromInternetCommand}"
                            BackgroundColor="#1E88E5"
                            TextColor="White"/>

                    <CollectionView ItemsSource="{Binding Filaments}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Filament">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Usun"
                                                      BackgroundColor="Red"
                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SettingsViewModel}}, Path=DeleteFilamentCommand}"
                                                      CommandParameter="{Binding .}"/>
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Frame Margin="0,5" Padding="10" BorderColor="LightGray">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="{Binding Type}" FontAttributes="Bold"/>
                                                <Label Text="{Binding Manufacturer}" FontSize="12" TextColor="Gray"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding SpoolPrice, StringFormat='{0:F2} zl'}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Frame>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="Dodaj nowy filament"
                            Command="{Binding AddFilamentCommand}"
                            BackgroundColor="#512BD4"
                            TextColor="White"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
